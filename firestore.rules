rules_version = '2';

// Rules สำหรับ Firebase project: sflowerbloomordermanager
// หน้าร้านอ่านแคตตาล็อกได้ แต่แก้ไขได้เฉพาะบัญชีแอดมินร้านเท่านั้น
service cloud.firestore {
  match /databases/{database}/documents {
    match /catalog/products {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'admin@sflowerbloom.local';
    }

    // ปิดทุก collection/document อื่นเป็นค่าเริ่มต้น
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
